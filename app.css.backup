@import 'variables.css';
@import 'reset.css';
@import 'typography.css';
@import 'animations.css';
@import 'utilities.css';
@import 'LegalPages.css';

body {
    background-color: var(--color-background);
    background-image: 
        radial-gradient(at 0% 0%, rgba(250, 98, 107, 0.05) 0px, transparent 50%),
        radial-gradient(at 100% 0%, rgba(30, 41, 59, 0.03) 0px, transparent 50%),
        radial-gradient(at 50% 100%, rgba(250, 98, 107, 0.02) 0px, transparent 50%);
    background-attachment: scroll; /* C-1: Mobil repaint sorunu giderildi */
    min-height: 100vh;
    color: var(--color-text-primary);
    overflow-x: hidden;
}

.app-layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

.main-content {
    flex: 1;
}

/* Glassmorphism Classes */
.glass {
    background: var(--color-glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: var(--shadow-glass);
}

.glass-dark {
    background: rgba(30, 41, 59, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
}

/* C-7: Glassmorphism mobil optimizasyonu — düşük GPU'lu cihazlarda blur azaltıldı */
@media (max-width: 768px) {
    .glass {
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }
    .glass-dark {
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
}

/* =========================================================
   Navbar Flex Fixes & Enhancements
   ========================================================= */
.navbar-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: nowrap;
}

.navbar-right {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    white-space: nowrap;
}

/* =========================================================
   Footer (Alt Bilgi) Layout
   ========================================================= */
.app-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: 4rem 0 2rem 0;
    margin-top: auto; /* Push to bottom when content is small */
}

.footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 3rem;
    margin-bottom: 3rem;
}

.footer-section h4 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text-primary);
}

.footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.footer-section a {
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
}

.footer-section a:hover {
    color: var(--color-primary);
}

.footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.875rem;
}
