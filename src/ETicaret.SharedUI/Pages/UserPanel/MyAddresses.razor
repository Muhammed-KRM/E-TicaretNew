@page "/panel/adreslerim"
@using ETicaret.Business.DTOs
@using ETicaret.Business.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject IAddressService AddressService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Adreslerim | ETicaret</PageTitle>

<div class="container padding-y-xl">
    <PageHeader Title="Adreslerim" Icon="📍" />

    <div class="row g-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Kayıtlı Adreslerim</h2>
                <button class="btn btn-primary" @onclick="ShowAddAddressModal">
                    ➕ Yeni Adres Ekle
                </button>
            </div>

            @if (isLoading)
            {
                <div class="glass text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                    <p class="mt-3 text-muted">Adresleriniz yükleniyor...</p>
                </div>
            }
            else if (!addresses.Any())
            {
                <div class="glass text-center py-5">
                    <div class="empty-state">
                        <div class="empty-icon">📍</div>
                        <h3>Henüz kayıtlı adresiniz yok</h3>
                        <p class="text-muted">Siparişlerinizi hızlıca tamamlamak için adres ekleyin.</p>
                        <button class="btn btn-primary mt-3" @onclick="ShowAddAddressModal">
                            ➕ İlk Adresimi Ekle
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var address in addresses)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="address-card glass @(address.IsDefault ? "address-default" : "")">
                                @if (address.IsDefault)
                                {
                                    <div class="address-badge">⭐ Varsayılan</div>
                                }
                                <div class="address-header">
                                    <h5 class="address-title">@address.Title</h5>
                                    <div class="address-actions">
                                        <button class="btn-icon" @onclick="() => ShowEditAddressModal(address)" title="Düzenle">
                                            ✏️
                                        </button>
                                        <button class="btn-icon text-danger" @onclick="() => DeleteAddress(address.Id)" title="Sil">
                                            🗑️
                                        </button>
                                    </div>
                                </div>
                                <div class="address-body">
                                    <p class="address-name">👤 @address.FullName</p>
                                    <p class="address-phone">📱 @address.Phone</p>
                                    <p class="address-location">📍 @address.CityName / @address.DistrictName</p>
                                    <p class="address-detail">@address.DetailedAddress</p>
                                    @if (!string.IsNullOrEmpty(address.ZipCode))
                                    {
                                        <p class="address-zip">Posta Kodu: @address.ZipCode</p>
                                    }
                                </div>
                                @if (!address.IsDefault)
                                {
                                    <div class="address-footer">
                                        <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => SetDefaultAddress(address.Id)">
                                            ⭐ Varsayılan Yap
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* Add/Edit Address Modal *@
@if (showModal)
{
    <div class="modal-backdrop show" @onclick="CloseModal"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Adres Düzenle" : "Yeni Adres Ekle")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="addressForm" OnValidSubmit="SaveAddress">
                        <DataAnnotationsValidator />
                        
                        <div class="mb-3">
                            <label class="form-label">Adres Başlığı *</label>
                            <InputText @bind-Value="addressForm.Title" class="form-control" placeholder="Örn: Ev, İş, Annem..." />
                            <ValidationMessage For="@(() => addressForm.Title)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ad Soyad *</label>
                            <InputText @bind-Value="addressForm.FullName" class="form-control" placeholder="Alıcının ad soyad" />
                            <ValidationMessage For="@(() => addressForm.FullName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Telefon *</label>
                            <InputText @bind-Value="addressForm.Phone" class="form-control" placeholder="0555 123 45 67" />
                            <ValidationMessage For="@(() => addressForm.Phone)" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Şehir *</label>
                                <InputNumber @bind-Value="addressForm.CityId" class="form-control" placeholder="Şehir ID" />
                                <ValidationMessage For="@(() => addressForm.CityId)" />
                                <small class="text-muted">Şehir seçimi için ID giriniz (1-81)</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">İlçe *</label>
                                <InputNumber @bind-Value="addressForm.DistrictId" class="form-control" placeholder="İlçe ID" />
                                <ValidationMessage For="@(() => addressForm.DistrictId)" />
                                <small class="text-muted">İlçe ID'si giriniz</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Detaylı Adres *</label>
                            <InputTextArea @bind-Value="addressForm.DetailedAddress" class="form-control" rows="3" 
                                          placeholder="Mahalle, sokak, bina no, daire no..." />
                            <ValidationMessage For="@(() => addressForm.DetailedAddress)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Posta Kodu</label>
                            <InputText @bind-Value="addressForm.ZipCode" class="form-control" placeholder="34000" />
                        </div>

                        <div class="form-check mb-3">
                            <InputCheckbox @bind-Value="addressForm.IsDefault" class="form-check-input" id="isDefaultCheck" />
                            <label class="form-check-label" for="isDefaultCheck">
                                Varsayılan adres olarak ayarla
                            </label>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">İptal</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(isEditMode ? "Güncelle" : "Kaydet")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .address-card {
        padding: 1.5rem;
        border-radius: var(--radius-lg);
        transition: var(--transition-normal);
        position: relative;
        border: 2px solid transparent;
    }

    .address-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
    }

    .address-default {
        border-color: var(--color-accent);
        background: linear-gradient(135deg, rgba(229, 169, 60, 0.05) 0%, rgba(229, 169, 60, 0.02) 100%);
    }

    .address-badge {
        position: absolute;
        top: -10px;
        right: 15px;
        background: var(--color-accent);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        box-shadow: var(--shadow-md);
    }

    .address-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--color-border);
    }

    .address-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--color-primary);
        margin: 0;
    }

    .address-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-icon {
        background: none;
        border: none;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        transition: var(--transition-fast);
        font-size: 1.1rem;
        border-radius: var(--radius-sm);
    }

    .btn-icon:hover {
        background: var(--color-surface-alt);
        transform: scale(1.1);
    }

    .address-body p {
        margin: 0.5rem 0;
        color: var(--color-text);
        font-size: 0.9rem;
    }

    .address-name {
        font-weight: 600;
    }

    .address-detail {
        color: var(--color-text-muted);
        line-height: 1.5;
        margin-top: 0.75rem;
    }

    .address-zip {
        font-size: 0.85rem;
        color: var(--color-text-light);
    }

    .address-footer {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--color-border-light);
    }

    .empty-state {
        padding: 2rem;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
    }

    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }

    .modal.show {
        display: block;
        z-index: 1050;
    }
</style>

@code {
    private List<AddressDto> addresses = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private Guid currentUserId;
    private Guid? editingAddressId = null;

    private AddressCreateDto addressForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAddresses();
    }

    private async Task LoadAddresses()
    {
        try
        {
            isLoading = true;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            
            if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var userId))
            {
                currentUserId = userId;
                addresses = await AddressService.GetUserAddressesAsync(userId);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("ozelders.showSwal", "error", "Hata", 
                $"Adresler yüklenirken hata oluştu: {ex.Message}", 0);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddAddressModal()
    {
        isEditMode = false;
        editingAddressId = null;
        addressForm = new AddressCreateDto();
        showModal = true;
    }

    private void ShowEditAddressModal(AddressDto address)
    {
        isEditMode = true;
        editingAddressId = address.Id;
        addressForm = new AddressCreateDto
        {
            Title = address.Title,
            FullName = address.FullName,
            Phone = address.Phone,
            CityId = address.CityId,
            DistrictId = address.DistrictId,
            DetailedAddress = address.DetailedAddress,
            ZipCode = address.ZipCode,
            IsDefault = address.IsDefault
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingAddressId = null;
        addressForm = new AddressCreateDto();
    }

    private async Task SaveAddress()
    {
        try
        {
            isSaving = true;

            if (isEditMode && editingAddressId.HasValue)
            {
                var updateDto = new AddressUpdateDto
                {
                    Title = addressForm.Title,
                    FullName = addressForm.FullName,
                    Phone = addressForm.Phone,
                    CityId = addressForm.CityId,
                    DistrictId = addressForm.DistrictId,
                    DetailedAddress = addressForm.DetailedAddress,
                    ZipCode = addressForm.ZipCode,
                    IsDefault = addressForm.IsDefault
                };
                await AddressService.UpdateAsync(editingAddressId.Value, updateDto, currentUserId);
                await JS.InvokeVoidAsync("ozelders.showSwal", "success", "Başarılı", 
                    "Adres başarıyla güncellendi.", 2000);
            }
            else
            {
                await AddressService.AddAsync(addressForm, currentUserId);
                await JS.InvokeVoidAsync("ozelders.showSwal", "success", "Başarılı", 
                    "Adres başarıyla eklendi.", 2000);
            }

            CloseModal();
            await LoadAddresses();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("ozelders.showSwal", "error", "Hata", 
                $"İşlem sırasında hata oluştu: {ex.Message}", 0);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAddress(Guid addressId)
    {
        var confirmed = await JS.InvokeAsync<bool>("ozelders.showConfirm", 
            "Adresi Sil", 
            "Bu adresi silmek istediğinize emin misiniz?",
            "Evet, Sil",
            "İptal");

        if (confirmed)
        {
            try
            {
                await AddressService.DeleteAsync(addressId, currentUserId);
                await JS.InvokeVoidAsync("ozelders.showSwal", "success", "Silindi", 
                    "Adres başarıyla silindi.", 2000);
                await LoadAddresses();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("ozelders.showSwal", "error", "Hata", 
                    $"Adres silinirken hata oluştu: {ex.Message}", 0);
            }
        }
    }

    private async Task SetDefaultAddress(Guid addressId)
    {
        try
        {
            await AddressService.SetDefaultAsync(addressId, currentUserId);
            await JS.InvokeVoidAsync("ozelders.showSwal", "success", "Başarılı", 
                "Varsayılan adres güncellendi.", 2000);
            await LoadAddresses();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("ozelders.showSwal", "error", "Hata", 
                $"İşlem sırasında hata oluştu: {ex.Message}", 0);
        }
    }
}
