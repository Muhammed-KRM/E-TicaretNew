@page "/wishlist"
@page "/user/wishlist"
@using ETicaret.Business.DTOs
@using ETicaret.SharedUI.ApiServices
@inject WishlistApiService WishlistApi
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Favorilerim - ETicaret</PageTitle>

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-heart-fill text-danger"></i> Favorilerim</h2>
                
                @if (wishlistItems != null && wishlistItems.Any())
                {
                    <button class="btn btn-outline-danger" @onclick="ClearAllAsync">
                        <i class="bi bi-trash"></i> Tümünü Temizle
                    </button>
                }
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                </div>
            }
            else if (wishlistItems == null || !wishlistItems.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-heart" style="font-size: 4rem; color: #ddd;"></i>
                    <h4 class="mt-3 text-muted">Favori listeniz boş</h4>
                    <p class="text-muted">Beğendiğiniz ürünleri favorilere ekleyerek daha sonra kolayca ulaşabilirsiniz.</p>
                    <a href="/products" class="btn btn-primary mt-3">
                        <i class="bi bi-shop"></i> Alışverişe Başla
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in wishlistItems)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="position-relative">
                                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 250px; object-fit: cover;">
                                    
                                    @if (!item.IsInStock)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 end-0 m-2">Stokta Yok</span>
                                    }
                                    
                                    <button class="btn btn-sm btn-danger position-absolute top-0 start-0 m-2" 
                                            @onclick="() => RemoveFromWishlistAsync(item.ProductId)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                                
                                <div class="card-body">
                                    <h5 class="card-title" style="height: 48px; overflow: hidden;">@item.Title</h5>
                                    
                                    <div class="mb-3">
                                        @if (item.DiscountedPrice.HasValue)
                                        {
                                            <div>
                                                <span class="text-decoration-line-through text-muted">@item.Price.ToString("C2")</span>
                                                <h4 class="text-danger mb-0">@item.DiscountedPrice.Value.ToString("C2")</h4>
                                            </div>
                                        }
                                        else
                                        {
                                            <h4 class="mb-0">@item.Price.ToString("C2")</h4>
                                        }
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a href="/products/@item.ProductId" class="btn btn-outline-primary flex-fill">
                                            <i class="bi bi-eye"></i> Görüntüle
                                        </a>
                                        
                                        @if (item.IsInStock)
                                        {
                                            <button class="btn btn-primary flex-fill" @onclick="() => AddToCartAsync(item.ProductId)">
                                                <i class="bi bi-cart-plus"></i> Sepete Ekle
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary flex-fill" disabled>
                                                <i class="bi bi-bell"></i> Haber Ver
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="card-footer bg-transparent text-muted small">
                                    <i class="bi bi-clock"></i> @item.AddedAt.ToString("dd MMM yyyy")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<WishlistItemDto>? wishlistItems;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadWishlistAsync();
    }

    private async Task LoadWishlistAsync()
    {
        isLoading = true;
        try
        {
            wishlistItems = await WishlistApi.GetUserWishlistAsync(Guid.Empty); // API JWT'den alır
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Hata: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RemoveFromWishlistAsync(Guid productId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Bu ürünü favorilerden çıkarmak istediğinizden emin misiniz?"))
            return;

        try
        {
            var result = await WishlistApi.RemoveFromWishlistAsync(Guid.Empty, productId); // API JWT'den alır
            if (result.Success)
            {
                wishlistItems = wishlistItems?.Where(w => w.ProductId != productId).ToList();
                await JS.InvokeVoidAsync("alert", "Ürün favorilerden çıkarıldı");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Hata: {ex.Message}");
        }
    }

    private async Task ClearAllAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Tüm favorileri temizlemek istediğinizden emin misiniz?"))
            return;

        try
        {
            var result = await WishlistApi.ClearWishlistAsync(Guid.Empty); // API JWT'den alır
            if (result.Success)
            {
                wishlistItems = new List<WishlistItemDto>();
                await JS.InvokeVoidAsync("alert", "Favori listeniz temizlendi");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Hata: {ex.Message}");
        }
    }

    private async Task AddToCartAsync(Guid productId)
    {
        try
        {
            // CartApiService kullanılacak
            await JS.InvokeVoidAsync("alert", "Ürün sepete eklendi!");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Hata: {ex.Message}");
        }
    }
}
