@page "/siparis-takip/{id:guid}"
@inject IOrderService OrderService

<PageTitle>Sipariş Takibi | ETicaret.com</PageTitle>

<div class="container padding-y-xl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Sipariş Detayı</h1>
        <a href="/panel/siparislerim" class="btn btn-outline-secondary">Siparişlerime Dön</a>
    </div>

    @if (isLoading)

    {
        <div class="text-center padding-xl">Yükleniyor...</div>
    }

    else if (order == null)

    {
        <div class="text-center padding-xl glass">Sipariş bulunamadı.</div>
    }

    else

    {
        <div class="row">
            <div class="col-md-8">
                <!-- Sipariş Durumu Timeline -->
                <div class="glass mb-4" style="border-radius: var(--radius-lg); padding: 2rem;">
                    <h3 class="mb-4">Sipariş Durumu: <span class="text-primary">@order.Status.ToString()</span></h3>

                    <div class="d-flex justify-content-between text-center position-relative">
                        <div class="progress position-absolute"
                            style="top: 25px; left: 10%; right: 10%; height: 3px; z-index: 0;">
                            <div class="progress-bar" role="progressbar"
                                style="width: 50%; background-color: var(--color-accent);" aria-valuenow="50"
                                aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div class="step position-relative" style="z-index: 1;">
                            <div
                                style="width: 50px; height: 50px; background: var(--color-accent); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
                                📋</div>
                            <small>Sipariş Alındı</small>
                        </div>
                        <div class="step position-relative" style="z-index: 1;">
                            <div
                                style="width: 50px; height: 50px; background: var(--color-accent); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
                                ⚙️</div>
                            <small>Hazırlanıyor</small>
                        </div>
                        <div class="step position-relative" style="z-index: 1;">
                            <div
                                style="width: 50px; height: 50px; background: #e9ecef; color: #6c757d; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
                                🚚</div>
                            <small>Kargoya Verildi</small>
                        </div>
                        <div class="step position-relative" style="z-index: 1;">
                            <div
                                style="width: 50px; height: 50px; background: #e9ecef; color: #6c757d; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
                                🏠</div>
                            <small>Teslim Edildi</small>
                        </div>
                    </div>
                </div>

                <!-- Ürünler -->
                <div class="glass" style="border-radius: var(--radius-lg); padding: 1.5rem;">
                    <h3 class="mb-4">Ürünler</h3>
                    <table class="table table-borderless align-middle">
                        <tbody>
                            @foreach (var item in order.Items)

                            {
                                <tr style="border-bottom: 1px solid var(--color-border);">
                                    <td>
                                        <div class="d-flex align-items-center gap-3 py-2">
                                            <div
                                                style="width: 50px; height: 50px; background: #f8f9fa; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                                📦</div>
                                            <div>
                                                <div style="font-weight: 600;">@item.ProductName</div>
                                                <small class="text-muted">Adet: @item.Quantity</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end" style="font-weight: 600;">@item.UnitPrice.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sağ: Sipariş Detayları -->
            <div class="col-md-4">
                <div class="glass" style="border-radius: var(--radius-lg); padding: 1.5rem;">
                    <h3 class="mb-4">Sipariş Bilgileri</h3>

                    <p class="text-muted mb-1">Sipariş No</p>
                    <p style="font-weight: 600;">#@order.Id.ToString().Substring(0,8).ToUpper()</p>

                    <p class="text-muted mb-1 mt-3">Sipariş Tarihi</p>
                    <p style="font-weight: 600;">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>

                    <p class="text-muted mb-1 mt-3">Toplam Tutar</p>
                    <p style="font-size: 1.5rem; font-weight: 800; color: var(--color-primary);">
                        @order.TotalPrice.ToString("C2")</p>

                    <hr class="my-4" style="border-color: var(--color-border);" />

                    <h4 class="mb-3">Teslimat Adresi</h4>
                    <p class="text-muted">Bu alana sipariş adresi gelecek.</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid? id { get; set; }



    private OrderDto? order;

    private bool isLoading = true;



    protected override async Task OnParametersSetAsync()

    {

        if (id.HasValue)

        {

            await LoadOrderAsync(id.Value);

        }

    }



    private async Task LoadOrderAsync(Guid orderId)

    {

        isLoading = true;

        try

        {

            // Guid.Empty (Kullanıcı ID'si) geçici mock

            order = await OrderService.GetOrderAsync(orderId, Guid.Empty, null);

        }

        catch

        {

            order = null;

        }

        finally

        {

            isLoading = false;

        }

    }
}
