@page "/odeme"
@inject IOrderService OrderService
@inject NavigationManager NavManager

<PageTitle>Güvenli Ödeme | ETicaret.com</PageTitle>

<div class="container padding-y-xl">
    <h1 class="mb-5 text-center">Güvenli Ödeme</h1>

    @if (orderCreated)
    {
        <div class="text-center padding-xl glass" style="border-radius: var(--radius-lg);">
            <div style="font-size: 5rem; margin-bottom: 1rem; color: var(--color-success);">✅</div>
            <h2>Siparişiniz Alındı!</h2>
            <p class="text-muted mb-4">Sipariş No: <strong>ORD-@Guid.NewGuid().ToString().Substring(0, 8).ToUpper()</strong></p>
            <a href="/panel/siparislerim" class="btn btn-primary">Siparişlerime Git</a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Sol Panel: Adımlar -->
            <div class="col-md-8">
                <!-- 1. Adres -->
                <div class="checkout-step glass mb-4" style="border-radius: var(--radius-lg); padding: 1.5rem;">
                    <h3 class="mb-3"><span style="display:inline-block; width:30px; height:30px; background:var(--color-primary); color:white; border-radius:50%; text-align:center; line-height:30px; margin-right:10px;">1</span> Teslimat Adresi</h3>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <div class="card p-3 border-primary" style="cursor: pointer; background-color: var(--color-primary-light);">
                                <strong>Ev Adresi</strong>
                                <p class="mb-0 text-muted">Atatürk Mah. İstiklal Cad. No:1 D:2, Kadıköy/İstanbul</p>
                            </div>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <div class="card p-3" style="cursor: pointer; border: 1px dashed var(--color-border); height: 100%; display: flex; align-items: center; justify-content: center; color: var(--color-primary);">
                                + Yeni Adres Ekle
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Kargo -->
                <div class="checkout-step glass mb-4" style="border-radius: var(--radius-lg); padding: 1.5rem;">
                    <h3 class="mb-3"><span style="display:inline-block; width:30px; height:30px; background:var(--color-primary); color:white; border-radius:50%; text-align:center; line-height:30px; margin-right:10px;">2</span> Kargo Seçenekleri</h3>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="shipping" id="ship1" checked>
                        <label class="form-check-label d-flex justify-content-between w-100" for="ship1">
                            <span>Standart Teslimat (2-3 İş Günü)</span>
                            <strong>Ücretsiz</strong>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="shipping" id="ship2">
                        <label class="form-check-label d-flex justify-content-between w-100" for="ship2">
                            <span>Hızlı Teslimat (Yarın Kapında)</span>
                            <strong>+ 39.90 TL</strong>
                        </label>
                    </div>
                </div>

                <!-- 3. Ödeme -->
                <div class="checkout-step glass mb-4" style="border-radius: var(--radius-lg); padding: 1.5rem;">
                    <h3 class="mb-3"><span style="display:inline-block; width:30px; height:30px; background:var(--color-primary); color:white; border-radius:50%; text-align:center; line-height:30px; margin-right:10px;">3</span> Ödeme Bilgileri</h3>
                    <p class="text-muted">Iyzico güvenli ödeme formu buraya yüklenecek.</p>
                    <div class="bg-light p-4 rounded text-center" style="border: 1px dashed #ccc;">
                        <span style="font-size: 2rem;">💳</span>
                        <p class="mt-2 mb-0">Güvenli Ödeme Formu Alanı</p>
                    </div>
                </div>
            </div>

            <!-- Sağ Panel: Sipariş Özeti -->
            <div class="col-md-4">
                <div class="order-summary glass" style="border-radius: var(--radius-lg); padding: 1.5rem; position: sticky; top: 100px;">
                    <h3 class="mb-4">Sipariş Özeti</h3>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Ara Toplam</span>
                        <span style="font-weight: 600;">1.250,00 ₺</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Kargo</span>
                        <span style="font-weight: 600; color: var(--color-accent);">Ücretsiz</span>
                    </div>

                    <hr style="border-color: var(--color-border);" />

                    <div class="d-flex justify-content-between mb-4 mt-3">
                        <span style="font-size: 1.2rem; font-weight: 700;">Toplam:</span>
                        <span style="font-size: 1.5rem; font-weight: 800; color: var(--color-primary);">1.250,00 ₺</span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="terms" @bind="acceptTerms">
                        <label class="form-check-label text-muted" for="terms" style="font-size: 0.85rem;">
                            <a href="/mesafeli-satis" target="_blank">Mesafeli Satış Sözleşmesi</a>'ni okudum ve onaylıyorum.
                        </label>
                    </div>

                    <button class="btn btn-primary w-100" style="background-color: var(--color-accent); border-color: var(--color-accent); font-weight: 600; padding: 0.8rem;" @onclick="CreateOrder" disabled="@(!acceptTerms || isProcessing)">
                        @if (isProcessing) { <span>İşleniyor...</span> } else { <span>Siparişi Onayla</span> }
                    </button>
                    
                    <div class="text-center mt-3" style="font-size: 1.5rem; filter: grayscale(100%); opacity: 0.5;">
                        🔒 💳 
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool acceptTerms = false;
    private bool isProcessing = false;
    private bool orderCreated = false;

    private async Task CreateOrder()
    {
        isProcessing = true;
        // Gerçek API çağrısı simülasyonu
        await Task.Delay(1500); 
        isProcessing = false;
        orderCreated = true;
    }
}
