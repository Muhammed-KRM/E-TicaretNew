@page "/"
@inject IProductService ProductService

<PageTitle>Alışverişin Yeni Adresi | ETicaret.com</PageTitle>

<!-- 1. Hero Section -->
<section class="hero-section"
    style="background: linear-gradient(135deg, var(--color-bg), var(--color-primary-light)); padding: 4rem 0; border-bottom: 1px solid var(--color-border);">
    <div class="container text-center">
        <h1 class="hero-title animate-slide-up"
            style="color: var(--color-text-primary); font-size: 3rem; font-weight: 800; margin-bottom: 1rem;">
            En Trend <span>Ürünler</span> Burada!
        </h1>
        <p class="hero-subtitle animate-fade-in"
            style="color: var(--color-text-muted); font-size: 1.2rem; margin-bottom: 2rem;">
            Elektronikten modaya binlerce ürün, harika fırsatlarla seni bekliyor.
        </p>

        <!-- Ana arama kutusu -->
        <div class="search-container animate-fade-in"
            style="max-width: 600px; margin: 0 auto; display: flex; gap: 0.5rem; background: white; padding: 0.5rem; border-radius: var(--radius-full); box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
            <span style="padding-left: 1rem; font-size: 1.5rem; align-self: center;">🔍</span>
            <input type="text" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleKeyDown" class="search-input"
                placeholder="Hangi ürünü arıyorsunuz? (Telefon, ayakkabı...)"
                style="flex: 1; border: none; outline: none; font-size: 1.1rem; padding: 0.5rem;" />
            <button class="btn btn-primary" @onclick="ExecuteSearch"
                style="border-radius: var(--radius-full); padding: 0.8rem 2rem;">Ara</button>
        </div>
    </div>
</section>

<!-- 2. Popüler Kategoriler -->
<section class="section" style="padding: 4rem 0;">
    <div class="container">
        <h2 class="text-center" style="margin-bottom: 2rem;">Popüler Kategoriler</h2>
        <div class="grid grid-4 category-grid"
            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.5rem;">
            <a href="/kategori/elektronik" class="category-card animate-float"
                style="text-align: center; padding: 2rem; background: white; border-radius: var(--radius-lg); box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-decoration: none; color: var(--color-text-primary); transition: transform 0.3s ease;">
                <span class="category-icon" style="font-size: 2.5rem; display: block; margin-bottom: 1rem;">💻</span>
                <span style="font-weight: 600;">Elektronik</span>
            </a>
            <a href="/kategori/giyim" class="category-card animate-float"
                style="animation-delay: 0.1s; text-align: center; padding: 2rem; background: white; border-radius: var(--radius-lg); box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-decoration: none; color: var(--color-text-primary); transition: transform 0.3s ease;">
                <span class="category-icon" style="font-size: 2.5rem; display: block; margin-bottom: 1rem;">👕</span>
                <span style="font-weight: 600;">Giyim</span>
            </a>
            <a href="/kategori/ev-yasam" class="category-card animate-float"
                style="animation-delay: 0.2s; text-align: center; padding: 2rem; background: white; border-radius: var(--radius-lg); box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-decoration: none; color: var(--color-text-primary); transition: transform 0.3s ease;">
                <span class="category-icon" style="font-size: 2.5rem; display: block; margin-bottom: 1rem;">🏠</span>
                <span style="font-weight: 600;">Ev & Yaşam</span>
            </a>
            <a href="/kategori/spor" class="category-card animate-float"
                style="animation-delay: 0.3s; text-align: center; padding: 2rem; background: white; border-radius: var(--radius-lg); box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-decoration: none; color: var(--color-text-primary); transition: transform 0.3s ease;">
                <span class="category-icon" style="font-size: 2.5rem; display: block; margin-bottom: 1rem;">⚽</span>
                <span style="font-weight: 600;">Spor & Outdoor</span>
            </a>
        </div>
    </div>
</section>

<!-- 3. Öne Çıkan Ürünler -->
<section class="section py-20" style="background: rgba(255,255,255,0.4); padding: 4rem 0;">
    <div class="container">
        <h2 class="text-center font-bold" style="margin-bottom: 2rem;">✨ Öne Çıkan Ürünler</h2>
        @if (featuredProducts?.Any() == true)

        {
            <div class="grid grid-4"
                style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
                @foreach (var product in featuredProducts)

                {
                    <div class="product-card"
                        style="background: white; border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center;">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">📦</div>
                        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-text-primary);">@product.Title
                        </h3>
                        <div style="font-weight: 700; color: var(--color-primary); font-size: 1.25rem; margin-bottom: 1rem;">
                            @product.Price.ToString("C2")</div>
                        <a href="/urun/@product.Id" class="btn btn-outline" style="width: 100%;">İncele</a>
                    </div>
                }
            </div>
        }

        else

        {
            <div class="text-center padding-xl glass" style="border-radius: var(--radius-lg)">
                <p class="text-muted">Şu an öne çıkan ürün bulunmamaktadır.</p>
            </div>
        }
    </div>
</section>

<!-- 4. Avantajlarımız -->
<section class="section" style="padding: 4rem 0;">
    <div class="container">
        <h2 class="text-center mb-12" style="margin-bottom: 2rem;">Neden Bizi Seçmelisiniz?</h2>
        <div class="grid grid-3 gap-8"
            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
            <div class="step-card"
                style="text-align: center; padding: 2rem; background: white; border-radius: var(--radius-lg); box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div style="font-size: 3rem; margin-bottom: 1rem;">🚀</div>
                <h3>Hızlı Teslimat</h3>
                <p>Siparişleriniz aynı gün kargoya verilir ve en kısa sürede size ulaşır.</p>
            </div>
            <div class="step-card"
                style="text-align: center; padding: 2rem; background: white; border-radius: var(--radius-lg); box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div style="font-size: 3rem; margin-bottom: 1rem;">🛡️</div>
                <h3>Güvenli Ödeme</h3>
                <p>Kredi kartı bilgileriniz 256-bit SSL sertifikası ile korunmaktadır.</p>
            </div>
            <div class="step-card"
                style="text-align: center; padding: 2rem; background: white; border-radius: var(--radius-lg); box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div style="font-size: 3rem; margin-bottom: 1rem;">↩️</div>
                <h3>Kolay İade</h3>
                <p>Koşulsuz şartsız 14 gün içinde kolay iade imkanı.</p>
            </div>
        </div>
    </div>
</section>

@using Microsoft.JSInterop
@code {
    [Inject] private NavigationManager NavManager { get; set; } = default!;



    private List<ProductDto> featuredProducts = new();

    private string searchQuery = string.Empty;



    protected override async Task OnInitializedAsync()

    {

        try

        {

            featuredProducts = await ProductService.GetFeaturedAsync();

        }

        catch { }

    }



    private void ExecuteSearch()

    {

        if (!string.IsNullOrWhiteSpace(searchQuery))

            NavManager.NavigateTo($"/arama?q={Uri.EscapeDataString(searchQuery)}");

        else

            NavManager.NavigateTo("/arama");

    }



    private void HandleKeyDown(KeyboardEventArgs e)

    {

        if (e.Key == "Enter") ExecuteSearch();

    }
}

