@page "/admin/kategoriler"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Kategori Yönetimi | ETicaret.com Admin</PageTitle>

<div class="container padding-y-xl">

    <!-- ===== SAYFA BAŞLIĞI ===== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">🗂️ Kategori Yönetimi</h1>
            <p class="text-muted mb-0">Kategorileri listele, ekle, düzenle ve sil</p>
        </div>
        @if (!_showForm)
        {
            <button class="btn btn-primary" @onclick="OpenAddForm">
                ➕ Yeni Kategori Ekle
            </button>
        }
    </div>

    <!-- ===== KATEGORİ FORMU (MODAL STİLİNDE) ===== -->
    @if (_showForm)
    {
        <div class="glass mb-4" style="border-radius:var(--radius-lg); padding:2rem;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">@(_isEditMode ? "✏️ Kategori Düzenle" : "➕ Yeni Kategori Ekle")</h2>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CloseForm">✕ İptal</button>
            </div>

            <EditForm Model="_formModel" OnValidSubmit="SaveCategoryAsync">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <!-- Kategori Adı -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Kategori Adı <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_formModel.Name"
                                   class="form-control"
                                   placeholder="Örn: Elektronik, Giyim..." />
                        <ValidationMessage For="@(() => _formModel.Name)" />
                    </div>

                    <!-- Üst Kategori -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Üst Kategori</label>
                        <InputSelect @bind-Value="_formModel.ParentCategoryId" class="form-select">
                            <option value="">-- Üst Kategori Yok (Ana Kategori) --</option>
                            @foreach (var cat in _categories.Where(c => c.Id != _editingCategoryId))
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <!-- Açıklama -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <InputTextArea @bind-Value="_formModel.Description"
                                       class="form-control"
                                       rows="2"
                                       placeholder="Kategori açıklaması (opsiyonel)" />
                    </div>

                    <!-- İkon URL -->
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">İkon URL</label>
                        <InputText @bind-Value="_formModel.IconUrl"
                                   class="form-control"
                                   placeholder="https://..." />
                        <div class="form-text">Emoji veya resim URL'si girebilirsiniz</div>
                    </div>

                    <!-- Sıralama -->
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Sıralama</label>
                        <InputNumber @bind-Value="_formModel.DisplayOrder"
                                     class="form-control"
                                     min="0" />
                    </div>

                    <!-- Aktif/Pasif -->
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <InputCheckbox @bind-Value="_formModel.IsActive"
                                           class="form-check-input"
                                           id="isActiveSwitch" />
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">
                                @(_formModel.IsActive ? "Aktif ✅" : "Pasif ❌")
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(_isEditMode ? "💾 Güncelle" : "➕ Ekle")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseForm">
                        İptal
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <!-- ===== LOADING STATE ===== -->
    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
            <p class="mt-3 text-muted">Kategoriler yükleniyor...</p>
        </div>
    }
    else if (_hasError)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <span>⚠️</span>
            <div>
                Kategoriler yüklenirken bir hata oluştu.
                <button class="btn btn-sm btn-outline-danger ms-3" @onclick="LoadCategoriesAsync">🔄 Tekrar Dene</button>
            </div>
        </div>
    }
    else if (!_categories.Any())
    {
        <div class="glass text-center py-5" style="border-radius:var(--radius-lg);">
            <span style="font-size:3rem;">🗂️</span>
            <h5 class="mt-3">Henüz kategori yok</h5>
            <p class="text-muted">İlk kategorinizi eklemek için yukarıdaki butonu kullanın.</p>
        </div>
    }
    else
    {
        <!-- ===== KATEGORİ TABLOSU ===== -->
        <div class="glass" style="border-radius:var(--radius-lg); overflow:hidden;">
            <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                <h5 class="mb-0">Kategoriler (@_categories.Count)</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">Sıra</th>
                            <th>Kategori Adı</th>
                            <th>Üst Kategori</th>
                            <th>Slug</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in _categories.OrderBy(c => c.DisplayOrder))
                        {
                            <tr>
                                <td class="text-center text-muted">@category.DisplayOrder</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(category.IconUrl))
                                        {
                                            <span style="font-size:1.25rem;">@category.IconUrl</span>
                                        }
                                        <div>
                                            <span class="fw-semibold">@category.Name</span>
                                            @if (!string.IsNullOrEmpty(category.Description))
                                            {
                                                <br /><small class="text-muted">@category.Description</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (category.ParentCategoryId.HasValue)
                                    {
                                        var parent = _categories.FirstOrDefault(c => c.Id == category.ParentCategoryId.Value);
                                        <span class="badge bg-light text-dark border">@(parent?.Name ?? "Bilinmiyor")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">— Ana Kategori</span>
                                    }
                                </td>
                                <td>
                                    <code class="text-secondary" style="font-size:0.8rem;">@category.Slug</code>
                                </td>
                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="badge bg-success">✅ Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">❌ Pasif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary"
                                                @onclick="() => OpenEditForm(category)"
                                                title="Düzenle">
                                            ✏️
                                        </button>
                                        <button class="btn btn-outline-danger"
                                                @onclick="() => DeleteCategoryAsync(category)"
                                                title="Sil">
                                            🗑️
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {
    // ─── State ───────────────────────────────────────────────────────────────
    private List<CategoryDto> _categories       = new();
    private bool              _isLoading        = true;
    private bool              _hasError         = false;
    private bool              _showForm         = false;
    private bool              _isEditMode       = false;
    private int?              _editingCategoryId;
    private bool              _isSaving         = false;

    // Form için mutable view model (CategoryCreateDto record'u @bind-Value ile uyumsuz)
    private CategoryFormModel _formModel = new();

    // ─── Lifecycle ───────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
        => await LoadCategoriesAsync();

    // ─── Veri Yükleme ────────────────────────────────────────────────────────
    /// <summary>
    /// Public API'den kategori listesini çeker.
    /// _categories listesi form'da üst kategori seçimi için de kullanılır.
    /// </summary>
    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        _hasError  = false;
        StateHasChanged();

        try
        {
            _categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories") ?? new();
        }
        catch (HttpRequestException httpEx)
        {
            _hasError = true;
            Console.Error.WriteLine($"[CategoryManagement][HTTP] Kategoriler yüklenirken hata: {httpEx.Message}");
        }
        catch (Exception ex)
        {
            _hasError = true;
            Console.Error.WriteLine($"[CategoryManagement][ERROR] Beklenmeyen hata: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ─── Form Yönetimi ───────────────────────────────────────────────────────
    private void OpenAddForm()
    {
        _isEditMode        = false;
        _editingCategoryId = null;
        _formModel         = new CategoryFormModel();
        _showForm          = true;
    }

    private void OpenEditForm(CategoryDto category)
    {
        _isEditMode        = true;
        _editingCategoryId = category.Id;
        _formModel         = new CategoryFormModel
        {
            Name             = category.Name,
            Description      = category.Description,
            IconUrl          = category.IconUrl,
            ParentCategoryId = category.ParentCategoryId,
            DisplayOrder     = category.DisplayOrder,
            IsActive         = category.IsActive
        };
        _showForm = true;
    }

    private void CloseForm()
    {
        _showForm          = false;
        _isEditMode        = false;
        _editingCategoryId = null;
    }

    // ─── CRUD İşlemleri ──────────────────────────────────────────────────────
    /// <summary>
    /// Kategori ekler veya günceller.
    /// Güvenlik: [Authorize(Roles = "Admin")] attribute'u CategoriesController'da uygulandı.
    /// </summary>
    private async Task SaveCategoryAsync()
    {
        _isSaving = true;
        try
        {
            HttpResponseMessage response;

            if (_isEditMode && _editingCategoryId.HasValue)
            {
                var updateDto = new CategoryUpdateDto(
                    Name:             _formModel.Name,
                    Description:      _formModel.Description,
                    IconUrl:          _formModel.IconUrl,
                    ParentCategoryId: _formModel.ParentCategoryId,
                    DisplayOrder:     _formModel.DisplayOrder,
                    IsActive:         _formModel.IsActive
                );
                response = await Http.PutAsJsonAsync($"api/categories/{_editingCategoryId.Value}", updateDto);
            }
            else
            {
                var createDto = new CategoryCreateDto(
                    Name:             _formModel.Name,
                    Description:      _formModel.Description,
                    IconUrl:          _formModel.IconUrl,
                    ParentCategoryId: _formModel.ParentCategoryId,
                    DisplayOrder:     _formModel.DisplayOrder,
                    IsActive:         _formModel.IsActive
                );
                response = await Http.PostAsJsonAsync("api/categories", createDto);
            }

            if (response.IsSuccessStatusCode)
            {
                CloseForm();
                await LoadCategoriesAsync();
                await JS.InvokeVoidAsync("alert", _isEditMode
                    ? "Kategori başarıyla güncellendi! ✅"
                    : "Kategori başarıyla eklendi! ✅");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.Error.WriteLine($"[CategoryManagement] Kayıt hatası ({response.StatusCode}): {error}");
                await JS.InvokeVoidAsync("alert", $"İşlem başarısız: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[CategoryManagement][ERROR] SaveCategory hatası: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Beklenmeyen bir hata oluştu.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Kategoriyi JS confirm ile onay alarak siler.
    /// </summary>
    private async Task DeleteCategoryAsync(CategoryDto category)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"'{category.Name}' kategorisini silmek istediğinize emin misiniz?\n\nDikkat: Alt kategoriler de etkilenebilir!");

        if (!confirmed) return;

        try
        {
            var response = await Http.DeleteAsync($"api/categories/{category.Id}");

            if (response.IsSuccessStatusCode)
            {
                await LoadCategoriesAsync();
                await JS.InvokeVoidAsync("alert", "Kategori silindi. ✅");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                await JS.InvokeVoidAsync("alert", "Kategori bulunamadı.");
            }
            else
            {
                Console.Error.WriteLine($"[CategoryManagement] Silme hatası: {response.StatusCode}");
                await JS.InvokeVoidAsync("alert", "Kategori silinirken bir hata oluştu.");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[CategoryManagement][ERROR] DeleteCategory hatası: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Beklenmeyen bir hata oluştu.");
        }
    }

    // ─── Form View Model ─────────────────────────────────────────────────────
    /// <summary>
    /// Blazor EditForm ile uyumlu mutable form modeli.
    /// CategoryCreateDto bir positional record olduğundan @bind-Value ile doğrudan kullanılamaz.
    /// Bu sınıf SOLID'in SRP ilkesiyle sadece UI form state'ini yönetir.
    /// </summary>
    private sealed class CategoryFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Kategori adı zorunludur.")]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 2)]
        public string  Name             { get; set; } = string.Empty;

        public string? Description      { get; set; }
        public string? IconUrl          { get; set; }
        public int?    ParentCategoryId { get; set; }
        public int     DisplayOrder     { get; set; } = 0;
        public bool    IsActive         { get; set; } = true;
    }
}

