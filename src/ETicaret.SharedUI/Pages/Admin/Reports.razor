@page "/admin/raporlar"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http

<PageTitle>Raporlar | ETicaret.com Admin</PageTitle>

<div class="reports-page">
    <div class="container">

        <!-- ===== SAYFA BAŞLIĞI ===== -->
        <div class="header-content mb-4">
            <div class="page-header">
                <h1 class="mb-1">📊 Satış Raporları</h1>
                <p class="text-muted mb-0">Detaylı analizler ve satış trendleri</p>
            </div>
        </div>

        <!-- ===== TARİH FİLTRESİ ===== -->
        <div class="date-filter mb-4">
            <div class="filter-group">
                <label>
                    <span>Başlangıç Tarihi</span>
                    <input type="date" class="date-input" @bind="_startDate" />
                </label>
                <label>
                    <span>Bitiş Tarihi</span>
                    <input type="date" class="date-input" @bind="_endDate" />
                </label>
                <button class="btn btn-primary" @onclick="LoadReportAsync">Filtrele</button>
                <button class="btn btn-secondary" @onclick="SetThisMonth">Bu Ay</button>
                <button class="btn btn-secondary" @onclick="SetLast6Months">Son 6 Ay</button>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
                <p class="mt-3 text-muted">Raporlar hazırlanıyor...</p>
            </div>
        }
        else if (_hasError)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2">
                <span>⚠️</span>
                <div>
                    Raporlar yüklenirken bir hata oluştu.
                    <button class="btn btn-sm btn-outline-danger ms-3" @onclick="LoadReportAsync">🔄 Tekrar Dene</button>
                </div>
            </div>
        }
        else if (_report != null)
        {
            <!-- ===== ÖZET KARTLARI ===== -->
            <div class="stats-section mb-4">
                <h2>Özet İstatistikler</h2>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-header">
                            <span class="stat-icon">💰</span>
                            <h3>Toplam Gelir</h3>
                        </div>
                        <div class="stat-body">
                            <div class="stat-row">
                                <strong>@FormatCurrency(_report.TotalRevenue)</strong>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <span class="stat-icon">📦</span>
                            <h3>Toplam Sipariş</h3>
                        </div>
                        <div class="stat-body">
                            <div class="stat-row">
                                <strong>@_report.TotalOrders Adet</strong>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <span class="stat-icon">👥</span>
                            <h3>Sipariş Veren Müşteri</h3>
                        </div>
                        <div class="stat-body">
                            <div class="stat-row">
                                <strong>@_report.TotalCustomers Kişi</strong>
                            </div>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <span class="stat-icon">📊</span>
                            <h3>Ortalama Sipariş Tutarı</h3>
                        </div>
                        <div class="stat-body">
                            <div class="stat-row">
                                <strong>@FormatCurrency(_report.AverageOrderValue)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <!-- ===== AYLIK SATIŞ TRENDİ ===== -->
                <div class="col-lg-8">
                    <div class="token-stats h-100">
                        <h2>Aylık Satış Trendi (Onaylı Siparişler)</h2>
                        @if (_report.MonthlySales.Any())
                        {
                            <div class="package-distribution mt-4">
                                @foreach (var month in _report.MonthlySales)
                                {
                                    var maxRev = _report.MonthlySales.Max(m => m.Revenue);
                                    var percent = maxRev > 0 ? (int)((month.Revenue / maxRev) * 100) : 0;
                                    
                                    <div class="package-bar">
                                        <div class="package-info">
                                            <span class="package-name">@FormatMonth(month.Month)</span>
                                            <span class="package-count">@FormatCurrency(month.Revenue) (@month.OrderCount sipariş)</span>
                                        </div>
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: @percent%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mt-3">Bu tarih aralığında onaylı satış bulunmamaktadır.</p>
                        }
                    </div>
                </div>

                <!-- ===== SİPARİŞ DURUM DAĞILIMI ===== -->
                <div class="col-lg-4">
                    <div class="vitrin-stats h-100">
                        <h2>Sipariş Durumları</h2>
                        <div class="vitrin-grid" style="grid-template-columns: 1fr;">
                            @foreach (var status in _report.OrdersByStatus.OrderByDescending(s => s.Count))
                            {
                                <div class="vitrin-item" style="background: var(--color-background); border: 1px solid var(--color-border);">
                                    <span class="vitrin-label" style="color: var(--color-text-secondary);">@GetStatusLabel(status.Status)</span>
                                    <span class="vitrin-value" style="color: var(--color-text-primary);">@status.Count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private AdminReportDto? _report;
    private bool _isLoading = true;
    private bool _hasError = false;

    private DateTime _startDate;
    private DateTime _endDate;

    protected override async Task OnInitializedAsync()
    {
        SetLast6Months();
        await LoadReportAsync();
    }

    private void SetThisMonth()
    {
        var now = DateTime.UtcNow;
        _startDate = new DateTime(now.Year, now.Month, 1);
        _endDate = _startDate.AddMonths(1).AddDays(-1);
    }

    private void SetLast6Months()
    {
        _endDate = DateTime.UtcNow;
        _startDate = _endDate.AddMonths(-6);
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _hasError = false;
        StateHasChanged();

        try
        {
            var url = $"api/admin/reports?from={_startDate:yyyy-MM-dd}&to={_endDate:yyyy-MM-dd}";
            _report = await Http.GetFromJsonAsync<AdminReportDto>(url);
        }
        catch (Exception ex)
        {
            _hasError = true;
            Console.Error.WriteLine($"[Reports] Hata: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatCurrency(decimal amount)
        => amount.ToString("N0", new System.Globalization.CultureInfo("tr-TR")) + " ₺";

    private static string FormatMonth(string yyyyMM)
    {
        if (yyyyMM.Length != 7) return yyyyMM;
        var parts = yyyyMM.Split('-');
        if (parts.Length != 2) return yyyyMM;
        
        var year = parts[0];
        var monthNum = int.Parse(parts[1]);
        
        var months = new[] { "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
        return $"{months[monthNum - 1]} {year}";
    }

    private static string GetStatusLabel(string status) => status switch
    {
        "Pending" => "Ödeme Bekleniyor",
        "Paid" => "Ödendi",
        "Preparing" => "Hazırlanıyor",
        "Shipped" => "Kargoda",
        "Delivered" => "Teslim Edildi",
        "Cancelled" => "İptal Edildi",
        "ReturnRequested" => "İade Talep",
        "Refunded" => "İade Edildi",
        "Failed" => "Başarısız",
        _ => status
    };
}
