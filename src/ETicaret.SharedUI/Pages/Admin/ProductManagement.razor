@page "/admin/urun-yonetimi"
@page "/admin/urun-ekle"
@page "/admin/urun-duzenle/{id:guid}"
@inject IProductService ProductService

<PageTitle>Ürün Yönetimi | ETicaret.com Admin</PageTitle>

<div class="container padding-y-xl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Ürün Yönetimi</h1>
        <a href="/admin/urun-ekle" class="btn btn-primary">➕ Yeni Ürün Ekle</a>
    </div>

    <div class="glass" style="border-radius: var(--radius-lg); padding: 1.5rem; overflow-x: auto;">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Görsel</th>
                    <th>Ürün Adı</th>
                    <th>Kategori</th>
                    <th>Fiyat</th>
                    <th>Stok</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                <!-- Liste buraya gelecek -->
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">Henüz ürün bulunmamaktadır.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public Guid? id { get; set; }
}
