@page "/admin/siparisler"
@inject IOrderService OrderService

<PageTitle>Sipariş Yönetimi | ETicaret.com Admin</PageTitle>

<div class="container padding-y-xl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Sipariş Yönetimi</h1>
    </div>

    <div class="glass" style="border-radius: var(--radius-lg); padding: 1.5rem; overflow-x: auto;">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Sipariş No</th>
                    <th>Müşteri</th>
                    <th>Tarih</th>
                    <th>Tutar</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                <!-- Liste buraya gelecek -->
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">Henüz sipariş bulunmamaktadır.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    
}
