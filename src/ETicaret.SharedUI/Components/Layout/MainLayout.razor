@inherits LayoutComponentBase

<div class="app-layout">
    <NavMenu />
    <main class="main-content">
        <ErrorBoundary @ref="errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <div class="error-panel text-center padding-xl">
                    <h3 class="text-danger">Beklenmeyen Bir Hata Oluştu</h3>
                    <p class="text-muted">@exception.Message</p>
                    <button class="btn btn-secondary mt-4" @onclick="() => errorBoundary?.Recover()">Tekrar Dene</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
    <footer class="app-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-section">
                    <h4>ETicaret.com</h4>
                    <p>Türkiye'nin en güvenilir alışveriş platformu.</p>
                </div>
                <div class="footer-section">
                    <h4>Alışveriş</h4>
                    <ul>
                        <li><a href="/arama">Ürünler</a></li>
                        <li><a href="/kategoriler">Kategoriler</a></li>
                        <li><a href="/indirimdekiler">İndirimdekiler</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Müşteri Hizmetleri</h4>
                    <ul>
                        <li><a href="/iletisim">İletişim</a></li>
                        <li><a href="/sss">Sıkça Sorulan Sorular</a></li>
                        <li><a href="/teslimat">Kargo ve Teslimat</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Kurumsal & Yasal</h4>
                    <ul>
                        <li><a href="/hakkimizda">Hakkımızda</a></li>
                        <li><a href="/gizlilik">Gizlilik Politikası</a></li>
                        <li><a href="/kvkk">KVKK Aydınlatma</a></li>
                        <li><a href="/kullanim-kosullari">Kullanım Koşulları</a></li>
                        <li><a href="/iptal-iade">İade Politikası</a></li>
                        <li><a href="/mesafeli-satis">Mesafeli Satış Sözleşmesi</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year ETicaret.com — Tüm hakları saklıdır.</p>
            </div>
        </div>
    </footer>
    <CookieConsent />
    <AuthorizeView>
        <Authorized>
            <BanWarningPopup />
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private Microsoft.AspNetCore.Components.Web.ErrorBoundary? errorBoundary;

    protected override void OnParametersSet()
    {
        // Sayfa değiştiğinde hataları sıfırla
        errorBoundary?.Recover();
    }
}

